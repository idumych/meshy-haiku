 *
 * Application resources.  No vector icon is defined here yet: HVIF is a
 * binary format that Icon-O-Matic writes, so add one by opening this file in
 * Icon-O-Matic (or pasting its exported "large icon" block below) rather than
 * hand-editing bytes.
 */

resource app_signature "application/x-vnd.Meshy-Haiku";

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_RELEASE,
	internal = 0,

	short_info = "Meshy",
	long_info  = "Meshy for Haiku — a native MeshCore client"
};

resource app_flags B_SINGLE_LAUNCH;

/* Meshy can open meshcore:// links shared by other clients. */
resource file_types message {
	"types" = "application/x-vnd.Meshy-Haiku"
};
